# Python-in-deep# Read input values for X and N
X = int(input())
N = int(input())

total_sum = 0

# Loop through each term from 1 to N
for i in range(1, N + 1):
    # Calculate the exponent for the current term
    power = 2 * i
    
    # Calculate the value of the term
    term = X ** power
    
    # Alternate the sign: positive for odd steps, negative for even steps
    if i % 2 == 1:
        total_sum += term
    else:
        total_sum -= term

# Print the final calculated sum
print(total_sum)
