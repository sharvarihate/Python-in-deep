n = int(input())

for i in range(1, n + 1):
    spaces = ("  ") * (n - i)
    symbols = ("+ ") * (i - 1) + ("# ")
    each_row = spaces + symbols
    print(each_row)

for i in range(n - 1, 0, -1):
    spaces = ("  ") * (n - i)
    symbols = ("+ ") * (i - 1) + ("# ")
    each_row = spaces + symbols
    print(each_row)
